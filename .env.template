# Copy to .env and fill in. This single file is read by every service
# (api, bot and db) through `env_file` in docker-compose.yml.
#
# REQUIRED: the service refuses to start if the line is missing (an empty value is fine
#           where the comment says so).
# OPTIONAL: can be left out or empty.

# --- Telegram (OPTIONAL) ---
# The token and chats are managed from the admin panel (Notificaciones). These three
# values only seed the database the first time the API starts.
TELEGRAM_TOKEN=YOUR_TOKEN
TELEGRAM_GROUP_ID=YOUR_GROUP_ID
TELEGRAM_ADMIN_CHAT_ID=MAIN_ADMIN_TELEGRAM_ID

# --- Database, REQUIRED (db creates it, api connects to it) ---
MARIADB_HOST=laviciacion-db
MARIADB_ROOT_PASSWORD=CHANGE_ME
MARIADB_DATABASE=laviciacion
MARIADB_USER=laviciacion
MARIADB_PASSWORD=CHANGE_ME

# --- API security, REQUIRED ---
# Emergency admin: on every API start the user "admin" (name "Dios") is created or
# restored with this password. Use a long, unique one and keep it out of daily use.
# It is not a player: it never appears in rankings, statistics or notices.
GOD_ADMIN_PASS=CHANGE_ME
SECRET_KEY=CHANGE_ME
# Session length in minutes (10080 = 7 days); it is not renewed while you use the app
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:3000"]

# --- External services ---
# RAWG (game search and covers), OPTIONAL: without a key, searching and syncing games does nothing.
RAWG_API_KEY=YOUR_API_KEY
# Old way of giving the same key (a URL with `key=...` in it). Still read if RAWG_API_KEY is empty;
# new installations do not need it.
# RAWG_URL=
# AI-written notices, OPTIONAL. These only seed the settings the first time the API starts (and only if
# the AI key is empty); afterwards the provider, key, model, on/off switches and prompts are edited from
# the admin panel. AI_PROVIDER is "google" (default) or "openai"; leave AI_MODEL empty for the provider's
# default model. The old OPENAI_API_KEY / OPENAI_MODEL still seed an "openai" setup if AI_API_KEY is empty.
AI_PROVIDER=google
AI_API_KEY=
AI_MODEL=

# --- Outgoing mail: password recovery ("he olvidado mi contraseña"), OPTIONAL ---
# Leave SMTP_HOST empty and the login page still shows the link, but the API answers
# that recovery is not configured (an admin can always set a password from the panel).
# PUBLIC_URL is where users reach the app from outside; the emailed link points there.
PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
# "starttls" (port 587, the default) or "ssl" (port 465). "none" sends without encryption: only for a local mail catcher
SMTP_SECURITY=starttls
# The From address of the emails
SMTP_EMAIL=
# Login for the SMTP server; empty = the From address
SMTP_USER=
SMTP_PASS=

# --- Bot -> API, REQUIRED by the bot ---
# The bot logs in as the superadmin "admin" with GOD_ADMIN_PASS and is read-only, except for /activate
# (it sets the sender's own Telegram id, from the group only).
API_URL=http://laviciacion-api:5000/api/v1

# --- Database storage (OPTIONAL) ---
# Empty (default): the database lives in ./db/data (bind mount). Right for a Linux server.
# On Windows (Docker Desktop) MariaDB 12+ cannot rebuild tables on that folder, so migrations
# such as 012 fail: set it to laviciacion_db_data to use a Docker named volume instead.
# The data is then NOT in ./db/data: use mariadb-dump for backups (see docs/deployment.md).
# DB_DATA=laviciacion_db_data

# --- Images and front proxy (OPTIONAL) ---
# Release of the published images that `docker compose pull` fetches (default: latest).
# LAVI_VERSION=2.0.0
# Where the front's nginx sends /api (default: the API container) and the DNS server it resolves
# that name with (default: Docker's embedded one). Only needed outside this compose setup.
# API_UPSTREAM=http://laviciacion-api:5000
# DNS_RESOLVER=127.0.0.11

# --- Published ports on the host (OPTIONAL) ---
# <SERVICE>_HOST_IP: the address the port is bound to; <SERVICE>_HOST_PORT: the port on the host
# (inside the containers they are always 3000, 5000 and 3306). Defaults are what is shown here.
# Example for a server that exposes the front on its internal address: FRONT_HOST_IP=10.0.0.2
# FRONT_HOST_IP=0.0.0.0
# FRONT_HOST_PORT=3000
# API_HOST_IP=127.0.0.1
# API_HOST_PORT=5000
# DB_HOST_IP=127.0.0.1
# DB_HOST_PORT=3307

# --- Runtime ---
# Interactive API docs (/api/v1/docs, /redoc, /openapi.json) list every endpoint: keep them off
# in production and set to true only for local development. OPTIONAL (default false)
API_DOCS_ENABLED=false
# Time zone of the containers: the season changes at local midnight. OPTIONAL
TZ=Europe/Madrid
# OPTIONAL. Proxies uvicorn trusts to tell it the real client address (X-Forwarded-For), comma
# separated. Behind nginx the API only sees the container network, so the per-client login limit
# stays off until this lists the proxy in front (the default is 127.0.0.1)
# FORWARDED_ALLOW_IPS=
# REQUIRED (for Sentry's environment label)
ENVIRONMENT=development
# REQUIRED lines; leave the value empty to disable Sentry
SENTRY_URL_API=
SENTRY_URL_BOT=
# REQUIRED: INFO or DEBUG
API_LOG_LEVEL=INFO
BOT_LOG_LEVEL=INFO
