// The equivalent of .github/dependabot.yml for GitLab (run by .gitlab/ci/renovate.yml). Nothing reads it on GitHub.
// Weekly, grouped so a week of updates is one merge request per ecosystem, and each ecosystem on its own weekday so
// they rarely coexist (main requires branches to be up to date). Titles use the Conventional Commits prefix the MR
// title check requires.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  timezone: "Europe/Madrid",
  semanticCommits: "enabled",
  semanticCommitType: "chore",
  dependencyDashboard: false,
  rebaseWhen: "behind-base-branch",
  // GitHub Actions are not used on GitLab; Dependabot keeps them up to date while the repository is on GitHub.
  "github-actions": { enabled: false },
  packageRules: [
    // Majors of Python packages and npm libraries arrive as separate MRs on purpose; minor and patch are grouped.
    {
      matchManagers: ["pip_requirements"],
      matchFileNames: ["api/**"],
      semanticCommitScope: "api",
      schedule: ["before 8am on monday"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "api-dependencies",
    },
    {
      matchManagers: ["pip_requirements"],
      matchFileNames: ["bot/**"],
      semanticCommitScope: "bot",
      schedule: ["before 8am on tuesday"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "bot-dependencies",
    },
    {
      matchManagers: ["npm"],
      matchFileNames: ["front/**"],
      semanticCommitScope: "front",
      schedule: ["before 8am on wednesday"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "front-dependencies",
    },
    // Majors: not grouped, same weekday as their ecosystem.
    { matchManagers: ["pip_requirements"], matchFileNames: ["api/**"], matchUpdateTypes: ["major"], semanticCommitScope: "api", schedule: ["before 8am on monday"] },
    { matchManagers: ["pip_requirements"], matchFileNames: ["bot/**"], matchUpdateTypes: ["major"], semanticCommitScope: "bot", schedule: ["before 8am on tuesday"] },
    { matchManagers: ["npm"], matchFileNames: ["front/**"], matchUpdateTypes: ["major"], semanticCommitScope: "front", schedule: ["before 8am on wednesday"] },
    // Base images, on Fridays. The Python major/minor (3.14 for api and bot) is a deliberate decision that must
    // match the CI jobs, so only patch-level changes arrive on their own.
    {
      matchManagers: ["dockerfile"],
      schedule: ["before 8am on friday"],
    },
    { matchManagers: ["dockerfile"], matchFileNames: ["api/**"], semanticCommitScope: "api" },
    { matchManagers: ["dockerfile"], matchFileNames: ["bot/**"], semanticCommitScope: "bot" },
    { matchManagers: ["dockerfile"], matchFileNames: ["front/**"], semanticCommitScope: "front" },
    {
      matchManagers: ["dockerfile"],
      matchPackageNames: ["python"],
      matchUpdateTypes: ["major", "minor"],
      enabled: false,
    },
    // The MariaDB image in docker-compose.yml: only patch releases of the pinned series arrive on their own.
    // Moving to another series is a data decision (docs/desarrollo/deployment.md#mariadb-version).
    {
      matchManagers: ["docker-compose"],
      matchPackageNames: ["mariadb"],
      semanticCommitScope: "db",
      schedule: ["before 8am on friday"],
    },
    {
      matchManagers: ["docker-compose"],
      matchPackageNames: ["mariadb"],
      matchUpdateTypes: ["major", "minor"],
      enabled: false,
    },
    // Other images in the compose file are not tracked, as in dependabot.yml.
    {
      matchManagers: ["docker-compose"],
      excludePackageNames: ["mariadb"],
      enabled: false,
    },
  ],
}
